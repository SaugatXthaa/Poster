# TOPX Posters — environment configuration
# Copy to .env and edit before running `npm start` or `docker compose up`.

# HTTP port (default 3000)
PORT=3000

# REQUIRED — AES-256-GCM key source for encrypting user config tokens.
# Must be at least 24 characters. NEVER change this after users have generated
# manifests, or all existing tokens will become invalid.
# Generate a strong one with:  openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-stable-secret-2026

# TMDB API key (default is a shared demo key — replace with your own
# to avoid rate limits). Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=439c478a771f35c05022f9feabcca01c

# Where the SQLite DB + cached covers live (default ./data)
DATA_DIR=/app/data

# Optional outbound proxy (used by undici's ProxyAgent)
# HTTPS_PROXY=http://user:pass@proxy:8080
